# Rosé Pine Moon notifications; spacing matches the i3 desktop.
[global]
    monitor = 0
    follow = none
    width = 300
    height = (0, 200)
    origin = top-right
    offset = (10, 30)
    notification_limit = 3
    transparency = 0
    corner_radius = 6
    gap_size = 4
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#44415a"
    separator_height = 0
    font = Noto Sans 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no
    icon_position = left
    icon_theme = rose-pine-moon-icons,Adwaita
    min_icon_size = 24
    max_icon_size = 24
    progress_bar = true
    progress_bar_height = 5
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2
    progress_bar_min_width = 150
    progress_bar_max_width = 260
    highlight = "#c4a7e7"
    history_length = 0
    sticky_history = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    dmenu = /usr/bin/rofi -dmenu -config ~/.config/rofi/rofidmenu.rasi
    browser = /usr/bin/xdg-open

[urgency_low]
    background = "#2a273f"
    foreground = "#908caa"
    frame_color = "#393552"
    timeout = 5

[urgency_normal]
    background = "#2a273f"
    foreground = "#e0def4"
    frame_color = "#44415a"
    timeout = 5

[urgency_critical]
    background = "#2a273f"
    foreground = "#e0def4"
    frame_color = "#eb6f92"
    timeout = 120

[stack-volumes]
    appname = "some_volume_notifiers"
    set_stack_tag = "volume"
