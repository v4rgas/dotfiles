# Ghostty with the official Rosé Pine Moon palette.
font-family = JetBrains Mono
font-size = 10

# Built-in Rosé Pine Moon theme.
theme = Rose Pine Moon
background-opacity = 0.98

# Keep the terminal plain, with a little breathing room.
gtk-titlebar = false
window-decoration = false
window-padding-x = 8
window-padding-y = 6
window-padding-color = background

keybind = ctrl+shift+enter=new_window

# Local overrides (optional, untracked)
config-file = ?config.laptop
