#!/usr/bin/env bash
set -euo pipefail

cd "$HOME"
# Keep original paths separate from Rofi's display/output representation.
mapfile -d '' -t files < <(
    fd --type f --color never --print0 \
        --exclude node_modules --exclude .venv --exclude target \
        --exclude dist --exclude build --exclude go/pkg .
)
(( ${#files[@]} )) || exit 0

index=$(printf '%s\0' "${files[@]}" | rofi \
    -config "$HOME/.config/rofi/rofidmenu.rasi" \
    -dmenu -p Files -sep '\0' -i -matching fuzzy -sorting-method fzf \
    -no-custom -format i \
    -theme-str 'window { width: 900px; } listview { lines: 12; }') || exit 0
[[ $index =~ ^[0-9]+$ ]] && (( index < ${#files[@]} )) || exit 0
exec xdg-open "$HOME/${files[index]}"
