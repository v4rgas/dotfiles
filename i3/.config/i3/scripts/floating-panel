#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    calculator)
        criteria='[class="^com\.micelio\.Calculator$"]'
        launch=(ghostty --class=com.micelio.Calculator -e qalc -s 'autocalc on')
        ;;
    monitor)
        criteria='[class="^com\.micelio\.SystemMonitor$"]'
        monitor=htop
        if command -v btop >/dev/null 2>&1; then
            monitor=btop
        fi
        launch=(ghostty --class=com.micelio.SystemMonitor -e "$monitor")
        ;;
    volume)
        criteria='[class="(?i)^pavucontrol$"]'
        launch=(pavucontrol)
        ;;
    *) exit 2 ;;
esac

# Keep repeated clicks from launching another panel while the first maps.
exec 9>"${XDG_RUNTIME_DIR:?}/i3-panel-$1.lock"
flock -n 9 || exit 0
if i3-msg "$criteria focus" >/dev/null 2>&1; then
    exit 0
fi

"${launch[@]}" 9>&- </dev/null >/dev/null 2>&1 &
for ((attempt=0; attempt<50; attempt++)); do
    if i3-msg "$criteria focus" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.1
done
